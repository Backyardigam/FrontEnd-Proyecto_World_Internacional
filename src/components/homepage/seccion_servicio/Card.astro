---
import TagIcon from "../../iconos/TagIcon.astro";

export interface Props {
  servicio: CardData;
  style?: string;
}
export interface CardData {
  id: string;
  id_name: string;
  name: string;
  cost: string;
  compactDescription: string;
  tag: string[];
  mediaFile: string;
}

const { servicio, style } = Astro.props;
---

<div class:list={["max-w-80 bg-white shadow-sm drop-shadow-xl rounded-xl font-redhat overflow-hidden",style]}>
  <div class="">
    <img src={servicio.mediaFile} alt={servicio.name} class="aspect-7/4 w-full max-h-" />
  </div>
  <div class="p-5 gap-4 flex flex-col">
    <div class="">
      <p class="text-base">Circuito turistico</p>
      <p class="font-baloo font-semibold text-naranja-c text-3xl">
        {servicio.name}
      </p>
      <p class="text-lg">{servicio.compactDescription}</p>
    </div>
    <div class="flex flex-col justify-end space-y-3">
      <div class="w-full border-t-2 border-gray-300"></div>
      <div class="flex items-center justify-between space-x-2">
        <div>
          <ul>
            {servicio.tag.map(t => (
              <li>{t}</li>
            ))}
          </ul>
        </div>
        <div class="flex flex-col gap-2 items-center">
          <div class="flex gap-2">
            <TagIcon style="w-4" />
            <p>
              S/. {servicio.cost}
            </p>
          </div>
          <div class="bg-naranja-c w-auto rounded-sm p-2 text-white ">
            <a href=`/${servicio.id_name}`>Conoce más</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
