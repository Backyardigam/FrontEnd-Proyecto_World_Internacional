---
import Card, { type CardData } from "./Card.astro";
import { apiGet } from "../../../utils/apiClient";

let servicios: CardData[] = [];
let error: string | null = null;

try {
  servicios = await apiGet<CardData[]>("/services");
} catch (e) {
  console.error("Error al cargar los servicios:", e);
  error = "No se pudieron cargar los servicios en este momento. Por favor, intente más tarde.";
}
---

<section class="w-full bg-gray-200 flex flex-col items-center">
  <div
    class="font-redhat w-full flex justify-center items-center p-20 bg-gray-500"
  >
    <p>Descubre nuestros servicios</p>
  </div>
  {error ? (
    <div class="p-10 text-red-500">{error}</div>
  ) : (
    <>
      <!-- Vista para móviles (Carrusel) -->
      <div class="w-full flex sm:hidden gap-4 overflow-x-auto snap-x snap-mandatory p-10">
        {servicios.map(servicio => <Card servicio={servicio} style="flex-shrink-0 w-72 snap-center" />)}
      </div>
      <!-- Vista para tablets y escritorio (Grid) -->
      <div class="hidden max-w-5/6 sm:grid sm:grid-cols-2 lg:grid-cols-3 gap-8 p-10">
        {servicios.map(servicio => <Card servicio={servicio} />)}
      </div>
    </>
  )}
</section>
