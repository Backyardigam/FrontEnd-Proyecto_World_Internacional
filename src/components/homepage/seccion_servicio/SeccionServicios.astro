  >
    <p>Descubre nuestros servicos</p>
  </div>
  <div class="w-full flex sm:hidden gap-4 overflow-x-auto snap-x snap-mandatory p-10">
    <div class="inline-grid grid-rows-2 grid-flow-col gap-4 px-4">
        <Card style="flex-shrink-0 w-72" />
        <Card style="flex-shrink-0 w-72" />
        <Card style="flex-shrink-0 w-72" />
        <Card style="flex-shrink-0 w-72" />
        <Card style="flex-shrink-0 w-72" />
        <Card style="flex-shrink-0 w-72" />
      </div>
  </div>

  <div
    class="hidden max-w-5/6 sm:grid sm:grid-cols-2 lg:grid-cols-3 gap-8 p-10"
  >
    <Card />
    <Card />
    <Card />
    <Card />
    <Card />
    <Card />
  </div>
</section>
