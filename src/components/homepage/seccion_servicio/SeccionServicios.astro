---
import Card, { type CardData } from "./Card.astro";
import { apiGet } from "../../../utils/apiClient";
import Image from "astro/components/Image.astro";
import image from "../../../images/tours-background.jpg"
let servicios: CardData[] = [];
let error: string | null = null;

try {
  servicios = await apiGet<CardData[]>("/services");
} catch (e) {
  console.error("Error al cargar los servicios:", e);
  error = "No se pudieron cargar los servicios en este momento. Por favor, intente más tarde.";
}
---

<section id="servicios" class="w-full bg-gray-200 flex flex-col items-center">
  <div class="relative w-full font-redhat text-white text-center overflow-hidden">
    <img src="src/images/tours-background.jpg" alt="Paisaje impresionante durante un tour" class="absolute inset-0 w-full h-full object-cover" loading="eager" />
    <Image
      src={image}
      alt={`Seccion de servicio`}
      class="aspect-video w-full object-cover"
      width={320}
      height={180}
      format="webp"
    />
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="relative z-10 flex flex-col justify-center items-center p-16 md:p-24">
      <h2 class="text-4xl md:text-5xl font-bold drop-shadow-md">Explora el Mundo con Nuestros Tours</h2>
      <p class="mt-4 max-w-3xl text-lg md:text-xl drop-shadow">
        Embárcate en una aventura inolvidable. Ofrecemos una amplia gama de servicios y tours guiados diseñados para que descubras los mejores destinos de una manera auténtica y emocionante.</p>
    </div>
  </div>
  {error ? (
    <div class="p-10 text-red-500">{error}</div>
  ) : (
    <>
      <div class="w-full flex sm:hidden gap-3 overflow-x-auto snap-x snap-mandatory p-5">
        {servicios.map(servicio => <Card servicio={servicio} style="flex-shrink-0 w-75 snap-center snap-always" />)}
      </div>
      <div class="hidden max-w-5/6 sm:grid sm:grid-cols-2 lg:grid-cols-3 gap-8 py-10">
        {servicios.map(servicio => <Card servicio={servicio} />)}
      </div>
    </>
  )}
</section>
