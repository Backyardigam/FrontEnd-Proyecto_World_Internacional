---
import Logo from "../iconos/Logo.astro";
import LogoFacebook from "../iconos/LogoFacebook.astro";
import LogoInstagram from "../iconos/LogoInstagram.astro";
import PhoneLogo from "../iconos/PhoneLogo.astro";
import EmailLogo from "../iconos/EmailLogo.astro";
import MapsLogo from "../iconos/MapsLogo.astro";
---

<footer id="footer" class="py-15 bg-black text-white w-full font-redhat md:p-8 break-all">
  <div
  class="md:max-w-7xl mx-auto flex flex-col font-light space-y-10 items-center
  md:flex-row md:justify-between md:gap-8 md:flex md:text-xl"
  >
    <!-- Columna 1: Logo, Copyright y detalles -->
    <div class="flex-col max-w-2xs ">
      <a href="/" aria-label="Ir a la página de inicio">
        <Logo logoColor="fill-white" />
      </a>
      <p class="text-gray-400 text-sm mt-4 max-w-51 break-words">
        &copy; {new Date().getFullYear()} World International. Todos los derechos
        reservados.
      </p>
    </div>

    <!-- Columna 2: Contacto -->
    <div class="text-gray-200 w-auto flex-col flex ">
      <h2 class="text-2xl mb-4 self-center">Contáctanos</h2>
      <ul class="space-y-8">
        <li class="flex">
          <div class="flex gap-3 items-center top-0">
            <PhoneLogo name="min-w-6" />
            <p>Comunícate al:</p>
          </div>
          <ul class="pl-2 text-gray-300">
            <li>
              <a href="tel:+51933401708" class="hover:underline"
                >+51 933 401 708</a
              >
            </li>
            <li>
              <a href="tel:+51932121621" class="hover:underline"
                >+51 932 121 621</a
              >
            </li>
          </ul>
        </li>
        <li class="flex gap-3 items-center">
          <MapsLogo name="min-w-6" />
          <address class="not-italic">
            <a
              href="https://maps.app.goo.gl/BegnXMXC6fkP6N2B9"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:underline"
            >
              Av. San Martin 270, Tacna 23000
            </a>
          </address>
        </li>

        <li class="flex gap-3 items-center">
          <EmailLogo name="min-w-6" />
          <a
            href="mailto:worldintenacionaltsq@gmail.com"            
            class="hover:underline"><p>worldintenacionaltsq@gmail.com</p></a
          >
        </li>
      </ul>
    </div>

    <!-- Columna 3: Redes sociales -->
    <div class="text-gray-200 w-auto flex flex-col">
      <h2 class="text-2xl mb-4 self-center">Redes Sociales</h2>
      <ul class="space-y-4">
        <li class="flex items-center gap-3">
          <a
            href="https://www.facebook.com/World.International.Agy"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visita nuestra página de Facebook"
            class="hover:opacity-80 transition-opacity"
          >
            <LogoFacebook name="min-w-7" />
          </a>
          <a
            href="https://www.facebook.com/World.International.Agy"
            target="_blank"
            rel="noopener noreferrer"            
            class="hover:underline break-words"><p>world.internationa.agy</p></a
          >
        </li>
        <li class="flex items-center gap-3">
          <a
            href="https://www.instagram.com/worldinternationaltacna/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visita nuestro perfil de Instagram"
            class="hover:opacity-80 transition-opacity"
          >
            <LogoInstagram name="min-w-7" />
          </a>
          <a
            href="https://www.instagram.com/worldinternationaltacna/"
            target="_blank"
            rel="noopener noreferrer"            
            class="hover:underline break-words">wold_international_tacna</a
          >
        </li>
      </ul>
    </div>
  </div>
</footer>
