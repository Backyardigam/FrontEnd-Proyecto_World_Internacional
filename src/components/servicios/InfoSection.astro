---
interface Props {
    title: string;
    items: string[];
}
const { title, items } = Astro.props;
---
<section class="mb-10">
    <h2 class="text-2xl font-bold mb-4 border-b-2 border-naranja-c pb-2">{title}</h2>
    <ul class="list-disc list-inside space-y-2 text-gray-700">
        {items.map(item => <li>{item}</li>)}
    </ul>
</section>