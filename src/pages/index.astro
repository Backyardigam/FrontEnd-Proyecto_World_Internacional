---
import Footer from "../components/generales/Footer.astro";
import Header from "../components/generales/Header.astro";
import Slider from "../components/homepage/Slider.astro";
import Nosotros from "../components/homepage/Nosotros.astro";
import BotonVerde from "../components/generales/BotonVerde.astro";
import  SpeedInsights  from "@vercel/speed-insights/astro"
import "../styles/global.css";
import "../utils/authInitializer"
import SeccionServicios from "../components/homepage/seccion_servicio/SeccionServicios.astro";

---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <SpeedInsights />
    <link rel="icon" type="image/svg+xml" href="/logosolo0.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Descubre destinos increíbles con World International. Ofrecemos tours y paquetes turísticos diseñados para crear experiencias inolvidables. ¡Tu próxima aventura comienza aquí!" />
    <meta name="generator" content={Astro.generator} />
    <title>World International</title>
  </head>
  <body>
    <!-- El Header se renderiza con un componente cliente para manejar el estado de visibilidad -->
    <Header />
    <main class="relative">
      <div class="sticky top-0 h-screen">
        <Slider />
      </div>
      <div class="relative z-10 bg-white">
        <SeccionServicios/>
        <Nosotros />
      </div>
    </main>
    <Footer />
    <BotonVerde />

  </body>
  <script>
    var $buoop = {
      required: { e: -2, f: -2, o: -2, s: 14, c: 100 },
      insecure: true,
      api: 2025.1,
    };
    function $buo_f() {
      var e = document.createElement("script");
      e.src = "//browser-update.org/update.min.js";
      document.body.appendChild(e);
    }
    if (document.readyState === "complete") {
      $buo_f();
    } else {
      document.addEventListener("DOMContentLoaded", $buo_f);
    }
  </script>
</html>