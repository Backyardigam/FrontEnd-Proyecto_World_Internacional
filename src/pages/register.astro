---
import RegisterForm from "../components/user/RegisterForm.tsx";
import Header from "../components/generales/Header.astro";
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/logosolo0.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registro de Usuario</title>
  </head>
  <body>
    <Header />
    <main class="w-full font-redhat">
      <div
        class="max-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8"
      >
        <div class="max-w-md w-full space-y-8">
          <div>
            <h2 class="mt-6 text-center text-3xl font-baloo font-extrabold text-gray-900">
              Crea tu cuenta
            </h2>
          </div>
          <RegisterForm client:load />
        </div>
      </div>
    </main>
  </body>
</html>