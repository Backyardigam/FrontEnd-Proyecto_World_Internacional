    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/logosolo0.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script
      src="https://static.micuentaweb.pe/static/js/krypton-client/V4.0/stable/kr-payment-form.min.js"
      kr-public-key="TU_CLAVE_PUBLICA_AQUI"
      kr-post-url-success="visible"
      kr-language="es-ES"
    ></script>
    <title>Carrito de Compras - World International</title>
  </head>
  <body class="bg-gray-100">
    <Header />
    <main>
      <CheckoutPage client:load />
    </main>
    <Footer />
